# Example secrets file for the MYumar.HP_series firmwares.
# Copy to `secrets.yaml` in your ESPHome directory and fill in real values.
# NEVER commit your real secrets.yaml — it is git-ignored.

# Wi-Fi
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
wifi_password_ap: "YOUR_FALLBACK_AP_PASSWORD"

# API encryption keys (one per device).
# Generate with: https://esphome.io/components/api.html  (or `openssl rand -base64 32`)
api_key_saladeestar: "BASE64_KEY_HERE"
api_key_lite:        "BASE64_KEY_HERE"
api_key_lite_2:      "BASE64_KEY_HERE"
api_key_luz:         "BASE64_KEY_HERE"
api_key_mini:        "BASE64_KEY_HERE"
api_key_ninos:       "BASE64_KEY_HERE"

# OTA passwords (one per device).
ota_password_saladeestar: "HEX_PASSWORD_HERE"
ota_password_lite:        "HEX_PASSWORD_HERE"
ota_password_lite_2:      "HEX_PASSWORD_HERE"
ota_password_luz:         "HEX_PASSWORD_HERE"
ota_password_mini:        "HEX_PASSWORD_HERE"
ota_password_ninos:       "HEX_PASSWORD_HERE"
